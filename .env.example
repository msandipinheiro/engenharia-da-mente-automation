# Rota A — Buffer
BUFFER_API_KEY=
BUFFER_CHANNEL_ID=                        # Engenharia da Mente (marca padrão)
BUFFER_CHANNEL_ID_DIVINO_INCONSCIENTE=    # --marca divino-inconsciente
BUFFER_CHANNEL_ID_VIVER_EM_FLUXO=         # --marca viver-em-fluxo

# Rota B — Instagram Graph API (Meta)
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=                        # compartilhado; META_ACCESS_TOKEN_<MARCA> sobrescreve por marca
IG_BUSINESS_ACCOUNT_ID=                   # Engenharia da Mente
IG_BUSINESS_ACCOUNT_ID_DIVINO_INCONSCIENTE=
IG_BUSINESS_ACCOUNT_ID_VIVER_EM_FLUXO=

# Mídia pública (Buffer e Graph API baixam as imagens por URL). O caminho salvo em
# "midia" (ex.: queue/divino-inconsciente/media/...png) é anexado a esta base.
PUBLIC_MEDIA_BASE_URL=   # bucket público (S3/R2/etc.) ou raw.githubusercontent.com/<user>/<repo>/<commit>

# Hotmart (verificação, não escrita — ver scripts/verificar_produto_hotmart.py)
HOTMART_ACCESS_TOKEN=

# Claude API (planejamento de copy)
ANTHROPIC_API_KEY=
